{
  "name": "math-4a-vertical-mult",
  "version": "1.0.0",
  "description": "國小四年級數學【乘法直式計算】線上互動測驗與學生成績管理系統 (Cloudflare Workers + D1)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:local": "wrangler d1 execute math-4a-vertical-mult-db --local --file=./migrations/0001_math_vertical_mult.sql",
    "d1:remote": "wrangler d1 execute math-4a-vertical-mult-db --remote --file=./migrations/0001_math_vertical_mult.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.143.0"
  }
}
